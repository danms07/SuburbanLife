rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user has Admin role
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Check if user has Guard role
    function isGuard() {
      return isAuthenticated() && request.auth.token.guard == true;
    }

    // Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId) || isGuard();
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        request.resource.data.role == 'resident' && 
        request.resource.data.addressRef == null && 
        request.resource.data.familyMembers.size() == 0
      );
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'addressRef', 'familyMembers', 'admin', 'guard', 'resident', 'createdAt'])
      );
      allow delete: if isAdmin();
    }

    match /addresses/{addressId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /qr_codes/{qrId} {
      allow read: if isAdmin() || isGuard() || (isAuthenticated() && resource.data.creatorUid == request.auth.uid);
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.creatorUid == request.auth.uid &&
        request.resource.data.status == 'valid' &&
        get(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.addressRef).data.paymentStatus == 'paid'
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.creatorUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'revoked'
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.creatorUid == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );
    }

    match /documents/{documentId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.resident == true);
      allow write: if isAdmin();
    }

    match /document_folders/{folderId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.resident == true);
      allow write: if isAdmin();
    }

    match /document_categories/{catId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.resident == true);
      allow write: if isAdmin();
    }

    match /ownership_claims/{claimId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid && request.resource.data.status == 'pending review';
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userUid == request.auth.uid && resource.data.status == 'pending review');
    }

    match /access_logs/{logId} {
      allow read: if isGuard() || isAdmin();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.residentUid == request.auth.uid || resource.data.uploaderUid == request.auth.uid));
      allow create: if isAuthenticated() && 
        (request.resource.data.residentUid == request.auth.uid || request.resource.data.uploaderUid == request.auth.uid) &&
        request.resource.data.status == 'pending review';
      allow update, delete: if isAdmin();
    }

    match /facilities/{facilityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isAdmin() || (isAuthenticated() && configId != 'smtp_settings');
      allow write: if isAdmin();
    }
  }
}

