rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isGuard() {
      return isAuthenticated() && request.auth.token.guard == true;
    }

    function isValidUploadSize() {
      return request.resource != null && request.resource.size < 10 * 1024 * 1024;
    }

    function isAllowedProofOrPhoto() {
      return request.resource != null &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/pdf');
    }

    function isAllowedFacilityOrBookingDoc() {
      return request.resource != null &&
        request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    match /documents/admin_only/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /documents/{allPaths=**} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        (request.auth.token.resident == true || request.auth.token.roommate == true) &&
        (resource == null || resource.metadata == null || !('visibility' in resource.metadata) || resource.metadata.visibility != 'admin')
      );
      allow write: if isAdmin();
    }

    match /announcements/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /facility_documents/{facilityId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidUploadSize() && isAllowedFacilityOrBookingDoc();
      allow delete: if isAdmin();
    }

    match /booking_attachments/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create, update: if (isAdmin() || (isAuthenticated() && request.auth.uid == userId)) &&
        isValidUploadSize() &&
        isAllowedFacilityOrBookingDoc();
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /sanctions/{addressId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidUploadSize() && isAllowedProofOrPhoto();
      allow delete: if isAdmin();
    }

    match /payments/{ownerOrAddressId}/{allPaths=**} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          request.auth.uid == ownerOrAddressId ||
          (resource != null && resource.metadata != null &&
           (request.auth.uid == resource.metadata.uploaderUid || request.auth.uid == resource.metadata.uploader))
        )
      );
      allow create, update: if (isAdmin() || (isAuthenticated() && request.auth.uid == ownerOrAddressId)) &&
        isValidUploadSize() &&
        isAllowedProofOrPhoto();
      allow delete: if isAdmin();
    }

    match /ownership_proofs/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create, update: if (isAdmin() || (isAuthenticated() && request.auth.uid == userId)) &&
        isValidUploadSize() &&
        isAllowedProofOrPhoto();
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /visitor_ids/{allPaths=**} {
      allow read: if isGuard() || isAdmin();
      allow create, update: if (isGuard() || isAdmin()) && isValidUploadSize() && isAllowedProofOrPhoto();
      allow delete: if isAdmin();
    }

    match /visitor_plates/{allPaths=**} {
      allow read: if isGuard() || isAdmin();
      allow create, update: if (isGuard() || isAdmin()) && isValidUploadSize() && isAllowedProofOrPhoto();
      allow delete: if isAdmin();
    }
  }
}
